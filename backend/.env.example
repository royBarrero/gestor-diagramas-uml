# Copiar este archivo a backend/.env y completar los valores reales.
# NOTA: dentro de docker-compose, DATABASE_URL debe usar el hostname del
# servicio "db" (no "localhost"), porque los contenedores se resuelven por
# nombre de servicio en la red interna de Docker.
DATABASE_URL=postgresql://usuario:password@db:5432/gestor_diagramas_db

SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production

# Orígenes permitidos para CORS (FastAPI) y Socket.IO, separados por coma.
# Incluir el dominio/IP pública real donde sirvas el frontend.
CORS_ORIGINS=http://localhost:5173

# Opcional: si falta, CU08 (voz) y CU09 (foto) devuelven un error controlado
# en vez de romper el arranque del backend.
OPENAI_API_KEY=
